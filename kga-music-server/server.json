
import { Hono } from 'hono';
import { cors } from 'hono/cors';
import { serve } from '@hono/node-server';
import { spawn } from 'node:child_process';
import { createReadStream, existsSync, mkdirSync, statSync, unlinkSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { homedir } from 'node:os';

const PORT = 7777;
const TEMP_DIR = join(process.cwd(), '.kga-temp');       // file temporanei
const KEEP_DIR = join(homedir(), 'Music', 'KGA');        // download permanenti
mkdirSync(TEMP_DIR, { recursive: true });
mkdirSync(KEEP_DIR, { recursive: true });

const app = new Hono();
app.use('*', cors());                                     // il sito gira su altra origin

// stato dei job: id -> { status, file, mode, title }
const jobs = new Map();

// ---------- HEALTH: il frontend rileva cosi' se il server c'e' ----------
app.get('/health', (c) => c.json({ ok: true, ytdlp: true }));

// ---------- DOWNLOAD: avvia yt-dlp (mode=temp|keep) ----------
app.post('/download', async (c) => {
  const { videoId, mode = 'temp', title = videoId } = await c.req.json();
  if (!/^[\w-]{11}$/.test(videoId)) return c.json({ error: 'bad id' }, 400);

  const dir = mode === 'keep' ? KEEP_DIR : TEMP_DIR;
  const safe = String(title).replace(/[^\w\s-]/g, '').slice(0, 60).trim() || videoId;
  const outTemplate = join(dir, `${safe} [${videoId}].%(ext)s`);
  const jobId = `${videoId}-${Date.now()}`;
  jobs.set(jobId, { status: 'downloading', file: null, mode, title: safe });

  // yt-dlp: solo audio, converte in m4a (qualita' alta, file piccolo)
  const args = [
    `https://www.youtube.com/watch?v=${videoId}`,
    '-f', 'bestaudio',
    '-x', '--audio-format', 'm4a', '--audio-quality', '0',
    '-o', outTemplate,
    '--no-playlist', '--no-warnings',
  ];
  const proc = spawn('yt-dlp', args);
  let stderr = '';
  proc.stderr.on('data', (d) => { stderr += d; });
  proc.on('close', (code) => {
    const job = jobs.get(jobId);
    if (code === 0) {
      const found = readdirSync(dir).find((f) => f.includes(`[${videoId}]`));
      if (found) { job.status = 'ready'; job.file = join(dir, found); return; }
    }
    job.status = 'error';
    job.error = stderr.slice(-300);
  });

  return c.json({ jobId });
});

// ---------- STATUS: polling dal frontend ----------
app.get('/status/:jobId', (c) => {
  const job = jobs.get(c.req.param('jobId'));
  if (!job) return c.json({ error: 'not found' }, 404);
  return c.json({ status: job.status, error: job.error ?? null });
});

// ---------- STREAM: serve l'audio con supporto range (seek) ----------
app.get('/stream/:jobId', (c) => {
  const job = jobs.get(c.req.param('jobId'));
  if (!job || job.status !== 'ready' || !existsSync(job.file))
    return c.json({ error: 'not ready' }, 404);

  const size = statSync(job.file).size;
  const range = c.req.header('range');
  if (range) {
    const [s, e] = range.replace('bytes=', '').split('-');
    const start = Number(s), end = e ? Number(e) : size - 1;
    c.header('Content-Range', `bytes ${start}-${end}/${size}`);
    c.header('Accept-Ranges', 'bytes');
    c.header('Content-Type', 'audio/mp4');
    return c.body(createReadStream(job.file, { start, end }), 206);
  }
  c.header('Content-Type', 'audio/mp4');
  c.header('Content-Length', String(size));
  return c.body(createReadStream(job.file));
});

// ---------- DONE: il frontend notifica fine riproduzione -> cancella se temp ----
app.post('/done/:jobId', (c) => {
  const job = jobs.get(c.req.param('jobId'));
  if (job?.mode === 'temp' && job.file && existsSync(job.file)) {
    try { unlinkSync(job.file); } catch { /* in uso: lo prende il cleanup */ }
  }
  jobs.delete(c.req.param('jobId'));
  return c.json({ ok: true });
});

// ---------- CLEANUP: ogni 10 min cancella temp piu' vecchi di 30 min ----------
setInterval(() => {
  const now = Date.now();
  for (const f of readdirSync(TEMP_DIR)) {
    const p = join(TEMP_DIR, f);
    if (now - statSync(p).mtimeMs > 30 * 60 * 1000) {
      try { unlinkSync(p); } catch { /* ignora */ }
    }
  }
}, 10 * 60 * 1000);

serve({ fetch: app.fetch, port: PORT });
console.log(`♪ KGA music server → http://localhost:${PORT}`);
console.log(`  KEEP dir: ${KEEP_DIR}`);
console.log(`  TEMP dir: ${TEMP_DIR} (auto-cleanup 30 min)`);

